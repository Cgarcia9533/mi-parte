<?xml version="1.0" encoding="utf-8"?>
<!-- Fila 4x1: las mismas tres lineas, mas pequenas, y la camara a la derecha.
     Los otros dos botones no caben: para eso esta el cuadro 4x2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wFondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wObra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:textColor="@color/w_texto"
            android:text="OBRA" />

        <TextView
            android:id="@+id/wFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/w_flojo"
            android:text="" />

        <TextView
            android:id="@+id/wTareas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/w_flojo"
            android:text="" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wFoto"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_boton"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_camara"
        android:contentDescription="Foto rapida" />
</LinearLayout>
